{
	"core:fortress" : {
		"town" : {
			"mapObject" : {
				"filters" : {
					"fort" : [ "allOf", [ "fort" ], [ "noneOf", [ "citadel" ] ] ],
					"citadel" : [ "allOf", [ "citadel" ], [ "noneOf", [ "castle" ] ] ],
					"castle" : [ "allOf", [ "castle" ], [ "noneOf", [ "capitol" ] ] ]
				},
				"templates" : {
					"fort" : { "animation" : "adventureMap/fortress/fort.def" },
					"citadel" : { "animation" : "adventureMap/fortress/citadel.def" },
					"castle" : { "animation" : "adventureMap/fortress/castle.def" },
					"capitol" : { "animation" : "adventureMap/fortress/capitol.def" }
				}
			}
		}
	}
}